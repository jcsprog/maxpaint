    "version": "0.2.0",
    "configurations": [
    
    {
        "type": "harbour-dbg",
        "request": "attach",
        "name": "Attach Program",
        "process": "Program",
        "sourcePaths": ["${workspaceFolder}"]
    },
        
        {
            "type": "harbour-dbg",
            "request": "launch",
            "name": "Launch Program",
            "program": "${workspaceFolder}/Program",
            "workingDir": "${workspaceFolder}/",
            "sourcePaths": [
                "${workspaceFolder}"
            ]
        }
    ]
}